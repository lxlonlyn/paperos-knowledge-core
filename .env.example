# Cognee official configuration only.
SYSTEM_ROOT_DIRECTORY=/absolute/path/to/data/cognee/system
DATA_ROOT_DIRECTORY=/absolute/path/to/data/cognee/data
DB_PROVIDER=sqlite
DB_NAME=cognee_db
VECTOR_DB_PROVIDER=lancedb
VECTOR_DB_URL=/absolute/path/to/data/cognee/system/databases/cognee.lancedb
GRAPH_DATABASE_PROVIDER=kuzu
GRAPH_DATASET_DATABASE_HANDLER=kuzu
ENABLE_BACKEND_ACCESS_CONTROL=false
REQUIRE_AUTHENTICATION=false
TELEMETRY_DISABLED=true
LLM_PROVIDER=custom
LLM_MODEL=openai/replace-with-model-id
LLM_ENDPOINT=http://127.0.0.1:8082/v1
LLM_API_KEY=local-or-provider-key
LLM_TEMPERATURE=0.0
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=default
EMBEDDING_ENDPOINT=http://127.0.0.1:8081/v1
EMBEDDING_API_KEY=no-key-required
EMBEDDING_DIMENSIONS=768
EMBEDDING_MAX_COMPLETION_TOKENS=2048
EMBEDDING_BATCH_SIZE=5
